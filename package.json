{
  "name": "balatro-mcp-server",
  "version": "0.1.0",
  "description": "Local stdio MCP server for playing Balatro through a standalone game mod.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "bin": {
    "balatro-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "setup": "npm run build && npm run stage-mod && npm run mcp:config",
    "mcp:config": "node scripts/mcp-config.ts",
    "check": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "dev": "node src/index.ts",
    "doctor": "node src/index.ts --doctor",
    "stage-mod": "node play/stage-mod.ts",
    "install:macos": "node scripts/macos.ts",
    "install:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-mod.ps1",
    "launch:macos": "node scripts/macos.ts --launch",
    "test": "npm run build && node --test tests/*.test.ts",
    "release:check": "node scripts/release.ts --check",
    "release:export": "node scripts/release.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@modelcontextprotocol/server": "2.3.1",
    "typebox": "1.3.27",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
