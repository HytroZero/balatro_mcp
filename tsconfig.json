{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "env/**/*.ts", "play/*.ts", "tools/**/*.ts", "memory/**/*.ts", "model/**/*.ts", "tests/**/*.ts"]
}
